{
  "name": "@dareu/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Compact smart contracts for DareU",
  "type": "module",
  "scripts": {
    "build": "npm run build:v2 && npm run build:registry",
    "build:v2": "compact compile +0.31.1 src/dareu-v2.compact src/managed/dareu-v2",
    "build:registry": "compact compile +0.31.1 src/dareu-registry.compact src/managed/dareu-registry",
    "balance:preprod": "tsx scripts/admin/balance.ts preprod",
    "balance:preview": "tsx scripts/admin/balance.ts preview",
    "deploy:preprod": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/deploy-v2.ts preprod",
    "deploy:preview": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/deploy-v2.ts preview",
    "deploy:v2:preprod": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/deploy-v2.ts preprod",
    "deploy:v2:preview": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/deploy-v2.ts preview",
    "market:v2:create": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/market-v2.ts create",
    "market:v2:resolve": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/market-v2.ts resolve",
    "market:v2:cancel": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/market-v2.ts cancel",
    "deploy:registry:preprod": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/deploy-registry.ts preprod",
    "deploy:registry:preview": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/deploy-registry.ts preview",
    "registry:add": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/register-asset.ts add",
    "registry:disable": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/register-asset.ts disable",
    "market:create": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/market-v2.ts create",
    "market:resolve": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/market-v2.ts resolve",
    "market:cancel": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/admin/market-v2.ts cancel",
    "keeper:run": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/run-v2.ts",
    "keeper:service": "bash scripts/keeper/supervise-v2.sh",
    "keeper:multi": "bash scripts/keeper/manage-v2.sh",
    "keeper:publish": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/publish-v2.ts",
    "keeper:sync": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/sync-v2.ts",
    "keeper:resolve": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/resolve-v2.ts",
    "keeper:v2:run": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/run-v2.ts",
    "keeper:v2:preflight": "tsx scripts/keeper/preflight-v2.ts",
    "keeper:v2:wallet": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/wallet-v2.ts",
    "keeper:v2:prepare-wallet": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/prepare-wallet-v2.ts",
    "keeper:v2:db": "tsx scripts/keeper/db-v2.ts",
    "keeper:v2:publish": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/publish-v2.ts",
    "keeper:v2:sync": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/sync-v2.ts",
    "keeper:v2:resolve": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/keeper/resolve-v2.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:metadata": "node --import tsx scripts/shared/market-metadata.golden.ts",
    "start-proof-server": "docker run -p 6300:6300 midnightntwrk/proof-server:8.1.0 -- midnight-proof-server -v",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --watch --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "pg": "^8.13.1",
    "@scure/bip39": "^2.2.0",
    "effect": "3.21.4",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0",
    "rxjs": "^7.8.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
