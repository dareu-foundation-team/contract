MIDNIGHT_NETWORK=preprod
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
MIDNIGHT_NODE_WS_URL=wss://rpc.preprod.midnight.network
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
MIDNIGHT_FAUCET_URL=https://midnight-tmnight-preprod.nethermind.dev/
MIDNIGHT_WALLET_START_TIMEOUT_MS=300000
MIDNIGHT_WALLET_SYNC_TIMEOUT_MS=300000
MIDNIGHT_DUST_GENERATION_TIMEOUT_MS=3600000
MIDNIGHT_WALLET_SYNC_ALLOWED_GAP=50
# Cache synced wallet state to contract/.wallet-cache/<network>.json so repeated
# runs resync incrementally instead of replaying the full history. Set to 0 to
# disable; delete the file to force a clean full resync.
MIDNIGHT_WALLET_CACHE=1
# Write a checkpoint every N applied sync events so an interrupted first sync
# resumes from the last checkpoint instead of restarting from zero (default 200000).
MIDNIGHT_WALLET_CHECKPOINT_EVERY=200000
# Wallet key. Provide EITHER a 32-byte hex HD seed in MIDNIGHT_WALLET_SEED, OR a
# BIP39 recovery phrase (助记词, normally 24 English words) in MIDNIGHT_WALLET_MNEMONIC.
# MIDNIGHT_WALLET_MNEMONIC takes precedence. A value containing spaces in
# MIDNIGHT_WALLET_SEED is also treated as a mnemonic.
MIDNIGHT_WALLET_SEED=
MIDNIGHT_WALLET_MNEMONIC=
MIDNIGHT_PRIVATE_STATE_PASSWORD=

DAREU_OWNER_SECRET_KEY=
DAREU_PRIVATE_STATE_ID=dareu-preprod
DAREU_PAYMENT_TOKEN_HEX=
DAREU_LEADER_COMMISSION_BPS=1000
DAREU_PLATFORM_FEE_BPS=200

# Contract maintenance authority (upgrade key) — used by BOTH scripts/admin/deploy-v2.ts
# and scripts/admin/deploy-registry.ts. 32-byte hex; derive once (openssl rand -hex 32),
# back up COLD alongside DAREU_OWNER_SECRET_KEY, NEVER on the keeper server. If unset,
# the CMA is a random local key sampled by deployContract() and the contract cannot be
# upgraded (no verifier-key/maintenance update) after the local private-state store is
# lost. The same secret can be reused across every dareu-v2 instance and the registry
# so one CMA governs all of them, or use a distinct secret per instance for isolation.
DAREU_CMA_SECRET_HEX=

# --- Admin market CLI (scripts/market.ts) ---
# Postgres connection with INSERT/UPDATE on the markets table (write role).
DATABASE_URL=
# create: market metadata (MARKET_CLOSE_TIME is ISO 8601 or unix ms; MARKET_ORACLE is 32-byte hex)
MARKET_TITLE=
MARKET_CLOSE_TIME=
MARKET_ORACLE=
MARKET_CATEGORY=
MARKET_DESCRIPTION=
MARKET_IMAGE_URL=
MARKET_RESOLUTION_SOURCE=
MARKET_EXTERNAL_ID=
# resolve/cancel: target market id (32-byte hex); resolve also needs MARKET_OUTCOME=YES|NO
MARKET_ID=
MARKET_OUTCOME=
# withdraw: amount in token base units
TREASURY_AMOUNT=

# --- v2 per-asset deploy (scripts/admin/deploy-v2.ts, market-v2.ts) ---
# Register every deployed instance in dareu-registry before enabling its keeper. Reuses
# MIDNIGHT_WALLET_SEED/MNEMONIC + MIDNIGHT_PRIVATE_STATE_PASSWORD above.
# Owner (cold key).
DAREU_OWNER_SECRET_KEY=
# Operator (hot key, optional). If unset, the constructor defaults operator = owner
# (fine for a single-key demo deploy).
DAREU_OPERATOR_SECRET_KEY=
# sNIGHT domain separator (pad(32, "...") semantics), default: dareu:snight:v1
DAREU_V2_TOKEN_DOMAIN=dareu:snight:v1
# Vault underlying token color, 32-byte hex. Default (unset) = all-zero = native NIGHT.
DAREU_V2_UNDERLYING_HEX=
# Resolution bond / arbiter threshold seeded at deploy time.
DAREU_V2_BOND=1000000
DAREU_V2_THRESHOLD=1
DAREU_V2_PRIVATE_STATE_ID=dareu-v2-preprod

# --- v2 demo market (scripts/admin/market-v2.ts create|cancel) ---
# All optional — sane defaults are used when unset (see market-v2.ts).
DAREU_V2_MARKET_ID_SEED=
DAREU_V2_MARKET_CLOSE_TIME=
DAREU_V2_MARKET_CHALLENGE_WINDOW=
DAREU_V2_MARKET_FEE_BPS=
DAREU_V2_MARKET_BETTING_CUTOFF=
DAREU_V2_MARKET_ID=

# --- Multi-asset registry (scripts/admin/deploy-registry.ts, register-asset.ts) ---
# See contract/docs/README.md "Multi-asset registry" for the full add-asset runbook.
# One dareu-registry deployment per network; discovered off-chain by the
# webapp/keeper. Reuses MIDNIGHT_WALLET_SEED/MNEMONIC + MIDNIGHT_PRIVATE_STATE_PASSWORD.
#
# Registry owner (cold key). Optional — if unset, falls back to DAREU_OWNER_SECRET_KEY
# (same key governs both the registry and every market instance). Set this separately
# to split registry admin from market admin.
DAREU_REGISTRY_OWNER_SECRET_KEY=
DAREU_REGISTRY_PRIVATE_STATE_ID=
# Deployed registry ContractAddress (hex). Optional — if unset, register-asset.ts
# reads it from deployments/<network>-registry.json (written by deploy-registry.ts).
DAREU_REGISTRY_ADDRESS=

# Keeper v2 resolves its market address/color/decimals from the registry. Default
# all-zero = native NIGHT. Set this when running a keeper for another asset.
DAREU_KEEPER_ASSET_UNDERLYING_HEX=

# --- registry:add / registry:disable (per-asset record) ---
# Required for `npm run registry:add`:
DAREU_ASSET_SYMBOL=
# 32-byte hex. Unset/empty = all-zero = native NIGHT.
DAREU_ASSET_UNDERLYING_HEX=
# The deployed dareu-v2 market instance's ContractAddress (hex). Optional — if unset,
# read from deployments/<network>-v2.json (written by deploy-v2.ts).
DAREU_ASSET_MARKET_ADDRESS=
# Wrapped-token decimals actually deployed (Uint<8>). NIGHT=6, USDT/USDC=6, BTC=8.
# ETH: bridges do not exist on Midnight yet, and Uint<64> amounts overflow at native
# 18 decimals (~18 ETH max) — onboard ETH at REDUCED precision (e.g. 8) and record
# that reduced value here, not 18.
DAREU_ASSET_DECIMALS=
# 32-byte hex sNIGHT/wrapped-shielded color for this market instance. Optional — if
# unset, derived as rawTokenType(DAREU_ASSET_TOKEN_DOMAIN, market_address), matching
# dareu-v2.compact's snight_color() circuit (same value deploy-v2.ts prints as
# "sNIGHT color (rawTokenType)").
DAREU_ASSET_SNIGHT_COLOR=
# Only used when deriving DAREU_ASSET_SNIGHT_COLOR. Must match the token_domain the
# market instance was actually deployed with (deploy-v2.ts's DAREU_V2_TOKEN_DOMAIN).
DAREU_ASSET_TOKEN_DOMAIN=dareu:snight:v1
# "true"/"false", default true. registry:disable defaults this to "false" instead.
DAREU_ASSET_ENABLED=
