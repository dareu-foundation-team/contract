# Copy to .env.keeper.sports.local (ignored by Git).
# Configure exactly one wallet secret. Never commit or share it.
MIDNIGHT_WALLET_MNEMONIC=
# MIDNIGHT_WALLET_SEED=

# Optional per-Keeper proof server. Unset to reuse MIDNIGHT_PROOF_SERVER from .env.local.
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# Common DATABASE_URL, DAREU_OPERATOR_SECRET_KEY, network endpoints and private-state
# password may remain in .env.local. All three Keepers must use the single operator
# secret currently authorized by the deployed contract.
